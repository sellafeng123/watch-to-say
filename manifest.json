{
  "manifest_version": 3,
  "name": "WatchToSay",
  "version": "2.5.0",
  "minimum_chrome_version": "116",
  "description": "Turn what you watch into what you can say with contextual learning and guided speaking practice.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open WatchToSay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["corpus.js", "corpus-ui.js", "practice-session.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
